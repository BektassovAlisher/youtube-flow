# Copy to .env and fill in your keys.
# Port 5435 is the Postgres from docker-compose; use 5432 for a local server.
DATABASE_URL="postgresql://postgres:your_password@localhost:5435/lecture_agent"
DB_PASSWORD="your_password"
GOOGLE_API_KEY="your_google_api_key"
# Groq: speech recognition (Whisper) for recordings without subtitles
GROQ_API_KEY="your_groq_api_key"
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
TAVILY_API_KEY="your_tavily_api_key"

# Access (recommended for anything reachable from the internet).
# API_TOKEN: POST/DELETE on the API need it; the web app sends it for you.
# APP_PASSWORD: if set, the web app asks for it before processing, questions, audio and deletion.
API_TOKEN=""
APP_PASSWORD=""
SESSION_SECRET=""

# Optional
# GEMINI_MODEL=gemini-3.1-flash-lite   # summaries, podcast scripts, answers and the short checks
# GEMINI_FALLBACK_MODEL=               # optional: a second model for when the main one is overloaded
# GEMINI_THINKING_LEVEL=               # minimal | low | medium | high; empty keeps the model's default
# YOUTUBE_PROXY_URL="http://user:pass@proxy:port"  # when YouTube blocks the server's IP
# ALLOW_PRIVATE_URLS=false   # articles from the internal network (a company wiki); keep off if strangers reach the API
# MAX_CONCURRENT_JOBS=3      # videos processed at the same time
# TTS_CONCURRENCY=2          # parallel ElevenLabs requests (raise it on paid plans)
# WHISPER_FALLBACK=true      # speech recognition for videos without subtitles
# WHISPER_MAX_MINUTES=180    # on Groq's free plan use 120: it recognizes about 2 hours of audio per hour
# LIMIT_VIDEOS_PER_HOUR=20   # per client; 0 turns a limit off
# LIMIT_AUDIO_PER_HOUR=10
# LIMIT_QUESTIONS_PER_HOUR=120
